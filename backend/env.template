# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spur_chat

# LLM API Configuration
# Option 1: Ollama (Recommended - Local, no API key needed)
# Make sure Ollama is installed and running: https://ollama.ai
# Pull the model first: ollama pull qwen2.5:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:4b
LLM_PROVIDER=ollama

# Option 2: Google Gemini (Free tier available)
# Get your API key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_PROVIDER=gemini

# Option 3: OpenAI (Requires credits)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER=openai

# Optional: Rate limiting and token limits
MAX_MESSAGE_LENGTH=2000
MAX_TOKENS=500
MAX_MESSAGES_PER_SESSION=50

